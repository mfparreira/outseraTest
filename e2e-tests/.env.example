# Copie para .env para sobrescrever os padrões localmente (o .env não vai para o Git).
# No CI, defina estas variáveis em env: do workflow ou em Settings > Secrets and variables.

# Aplicação sob teste
E2E_BASE_URL=https://www.saucedemo.com

# Contas de teste (padrões = contas públicas de demonstração do SauceDemo)
E2E_STANDARD_USER=standard_user
E2E_LOCKED_USER=locked_out_user
E2E_PASSWORD=secret_sauce

# Navegador
E2E_HEADLESS=false            # padrão: true quando CI=true
# E2E_BROWSER_PATH=/usr/bin/chromium   # usar um Chromium/Chrome já instalado
# E2E_SLOW_MO=0               # ms entre ações (depuração)

# Timeouts (ms)
E2E_ACTION_TIMEOUT_MS=10000
E2E_EXPECT_TIMEOUT_MS=7000
E2E_STEP_TIMEOUT_MS=60000

# Evidências: always | on-failure | off
E2E_TRACE=on-failure
E2E_SCREENSHOT=always
